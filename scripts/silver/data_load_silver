/*
===============================================================================
             STORED PROCEDURE: LOAD SILVER LAYER (BRONZE -> SILVER)
===============================================================================

Script Purpose:
    This stored procedure performs the transformation and loading process
    required to populate the Silver layer from the Bronze layer.

    Source data from the Bronze layer is cleaned, standardized, validated,
    and transformed according to the data-quality rules identified during
    the Silver-layer development process.

Actions Performed:
    - Truncates existing Silver tables to support a full-refresh load.
    - Loads cleaned and transformed data from Bronze into Silver.
    - Removes duplicate customer records and retains the latest record.
    - Standardizes categorical values such as gender, marital status,
      product line, and country.
    - Handles missing, invalid, and inconsistent values.
    - Converts source date values into appropriate DATE formats.
    - Derives additional attributes such as product category IDs,
      product keys, product end dates, sales values, and prices.
    - Records the start time, end time, row count, and execution duration
      for each Silver table load.
    - Records the total execution time for the complete Silver-layer load.

Parameters:
    None.

    This stored procedure does not require any input parameters.

Usage Example:

    CALL silver.load_silver();

===============================================================================
*/

DROP PROCEDURE IF EXISTS silver.load_silver;

DELIMITER $$

CREATE PROCEDURE silver.load_silver()

BEGIN
    -- -------------------------------------------------------------------------
    -- Timing variables
    -- -------------------------------------------------------------------------

    DECLARE v_silver_start DATETIME(6);
    DECLARE v_silver_end   DATETIME(6);
    DECLARE v_table_start  DATETIME(6);
    DECLARE v_table_end    DATETIME(6);
    
    -- Record the start time of the complete Silver load.
    SET @silver_start_time = NOW(6);


	  -- =========================================================================
    -- 1. LOAD CRM CUSTOMER INFORMATION
    -- =========================================================================
	
    SET v_table_start = NOW(6);
    
    TRUNCATE TABLE silver.crm_cust_info;

	  INSERT INTO silver.crm_cust_info (
    cst_id,
    cst_key,
    cst_firstname,
    cst_lastname,
    cst_marital_status,
    cst_gndr,
    cst_create_date
	  )

	  SELECT
    cst_id,
    cst_key,

    -- Remove unwanted whitespace
    TRIM(cst_firstname) AS cst_firstname,
    TRIM(cst_lastname) AS cst_lastname,

    -- Standardize marital status
    CASE
        WHEN UPPER(TRIM(cst_marital_status)) = 'M' THEN 'Married'
        WHEN UPPER(TRIM(cst_marital_status)) = 'S' THEN 'Single'
        ELSE 'n/a'
    END AS cst_marital_status,

    -- Standardize gender
    CASE
        WHEN UPPER(TRIM(cst_gndr)) = 'F' THEN 'Female'
        WHEN UPPER(TRIM(cst_gndr)) = 'M' THEN 'Male'
        ELSE 'n/a'
    END AS cst_gndr,

    -- Convert blank and zero dates to NULL,
    -- then convert valid text dates back to DATE
	  STR_TO_DATE( NULLIF( NULLIF(TRIM(raw_create_date), ''), '0000-00-00'), '%Y-%m-%d' ) AS cst_create_date

	  FROM (
    SELECT
        cst_id,
        cst_key,
        cst_firstname,
        cst_lastname,
        cst_marital_status,
        cst_gndr,

        CAST(cst_create_date AS CHAR(10)) AS raw_create_date,

        ROW_NUMBER() OVER (
            PARTITION BY cst_id
            ORDER BY CAST(cst_create_date AS CHAR(10)) DESC
        ) AS flag_last

    FROM bronze.crm_cust_info
    WHERE cst_id IS NOT NULL

	  ) AS t

	  WHERE flag_last = 1;
	
    
    
    SET v_table_end = NOW(6);

    SELECT
        'silver.crm_cust_info' AS table_name,
        v_table_start AS start_time,
        v_table_end AS end_time,
        COUNT(*) AS rows_loaded,
        ROUND( TIMESTAMPDIFF( MICROSECOND, v_table_start, v_table_end) / 1000000, 3) AS duration_seconds
    FROM silver.crm_cust_info;
    
   -- =========================================================================
                      -- 2. LOAD CRM PRODUCT INFORMATION
   -- =========================================================================
   
   SET v_table_start = NOW(6);
  
  TRUNCATE silver.crm_prd_info;
  INSERT INTO silver.crm_prd_info (
	prd_id,
    cat_id,
	prd_key,
	prd_nm,
	prd_cost,
	prd_line,
	prd_start_dt,
	prd_end_dt
	)
	SELECT 
	prd_id, 
	REPLACE(substring(prd_key, 1, 5), '-', '_') AS cat_id,
		SUBSTRING(prd_key, 7, length(prd_key)) AS prd_key,
	prd_nm,
	IFNULL(prd_cost, 0) AS prd_cost,
	CASE UPPER(TRIM(prd_line)) 
		WHEN 'M' THEN 'Mountain'
		WHEN 'R' THEN 'Road'
		WHEN 'S' THEN 'Other Sales'
		WHEN'T' THEN 'Touring'
		ELSE 'n/a'
	END AS prd_line, 
	prd_start_dt,
	CAST(LEAD(prd_start_dt) OVER (PARTITION BY prd_key ORDER BY prd_start_dt)- INTERVAL 1 DAY AS DATE) AS prd_end_dt
	FROM bronze.crm_prd_info;
	
    
    
    SET v_table_end = NOW(6);

    SELECT
        'silver.crm_prd_info' AS table_name,
        v_table_start AS start_time,
        v_table_end AS end_time,
        COUNT(*) AS rows_loaded, ROUND( TIMESTAMPDIFF( MICROSECOND, v_table_start, v_table_end ) 
        / 1000000, 3) AS duration_seconds
    FROM silver.crm_prd_info;
	-- =========================================================================
		-- 3. LOAD CRM SALES DETAILS
	-- =========================================================================
	
    SET v_table_start = NOW(6);
    
    TRUNCATE silver.crm_sales_details;

	INSERT INTO silver.crm_sales_details (
	sls_ord_num,
	sls_prd_key,
	sls_cust_id,
    sls_order_dt,
    sls_ship_dt,
    sls_due_dt,
    sls_sales, 
    sls_quantity,
    sls_price
	)
	SELECT 
	sls_ord_num,
	sls_prd_key, 
	sls_cust_id,
	CASE WHEN sls_order_dt = 0 OR LENGTH(sls_order_dt) != 8 THEN NULL
		 ELSE STR_TO_DATE(CAST(sls_order_dt AS CHAR),'%Y%m%d') 
	END AS sls_order_dt,

	CASE WHEN sls_ship_dt = 0 OR LENGTH(sls_ship_dt) != 8 THEN NULL
	 	 ELSE STR_TO_DATE(CAST(sls_ship_dt AS CHAR),'%Y%m%d') 
	END AS sls_ship_dt,

	CASE WHEN sls_due_dt = 0 OR LENGTH(sls_due_dt) != 8 THEN NULL
		 ELSE STR_TO_DATE(CAST(sls_due_dt AS CHAR), '%Y%m%d')
	END AS sls_due_dt,


	CASE WHEN sls_sales = 0 OR sls_sales IS NULL OR sls_sales != sls_quantity * ABS(new_sls_price)
		 THEN sls_quantity * ABS(new_sls_price)
		 ELSE sls_sales
	END AS sls_sales,

	sls_quantity,
	new_sls_price AS sls_price
	FROM (
	SELECT 
	sls_ord_num, sls_prd_key, sls_cust_id, sls_order_dt, sls_ship_dt, 
    sls_due_dt, sls_sales, sls_quantity, sls_price,

	CASE WHEN sls_price IS NULL OR sls_price = 0 
		 THEN ABS(sls_sales / NULLIF(sls_quantity,0))
         WHEN sls_price < 0
         THEN ABS(sls_price)
		 ELSE sls_price 
	END AS new_sls_price
	FROM bronze.crm_sales_details
	)
	AS t;
    
     SET v_table_end = NOW(6);

    SELECT
        'silver.crm_sales_details' AS table_name,
        v_table_start AS start_time,
        v_table_end AS end_time,
        COUNT(*) AS rows_loaded, ROUND( TIMESTAMPDIFF( MICROSECOND, v_table_start, v_table_end ) 
        / 1000000, 3) AS duration_seconds
    FROM silver.crm_sales_details;
	-- =========================================================================
		-- 4. LOAD ERP CUSTOMER INFORMATION
	-- =========================================================================

	SET v_table_start = NOW(6);
    
    TRUNCATE TABLE silver.erp_cust_az12;
	INSERT INTO silver.erp_cust_az12 (
	cid, bdate, gen )
	SELECT  
	CASE WHEN cid LIKE 'NAS%' THEN SUBSTRING(cid,4, LENGTH(cid))
		 ELSE cid
	END AS cid,

	CASE WHEN bdate > CURRENT_DATE() THEN NULL 
		 ELSE bdate 
	END AS bdate,

	CASE WHEN UPPER(TRIM(gen)) IN ('M', 'Male') THEN 'Male'
		 WHEN UPPER(TRIM(gen)) IN ('F','Female') THEN 'Female'
		 ELSE 'n/a'
	END AS gen
	FROM bronze.erp_cust_az12;
    
	SET v_table_end = NOW(6);

    SELECT
        'silver.erp_cust_az12' AS table_name,
        v_table_start AS start_time,
        v_table_end AS end_time,
        COUNT(*) AS rows_loaded, ROUND( TIMESTAMPDIFF( MICROSECOND, v_table_start, v_table_end ) 
        / 1000000, 3) AS duration_seconds
    FROM silver.erp_cust_az12;

	-- =========================================================================
    -- 5. LOAD ERP CUSTOMER LOCATION
    -- =========================================================================
	SET v_table_start = NOW(6);
    TRUNCATE silver.erp_loc_a101; 
	INSERT INTO silver.erp_loc_a101 
	(cid,cntry)
        
	SELECT 
	REPLACE(cid, '-', '') AS cid,

	CASE WHEN TRIM(cntry) = 'DE' THEN 'Germany'
		 WHEN TRIM(cntry) IN ('US', 'USA') THEN 'United States'
		 WHEN TRIM(cntry) = '' OR cntry IS NULL THEN 'n/a'
		 ELSE TRIM(cntry)
	END AS cntry
	FROM bronze.erp_loc_a101;
    
	SET v_table_end = NOW(6);

    SELECT
        'silver.erp_loc_a101' AS table_name,
        v_table_start AS start_time,
        v_table_end AS end_time,
        COUNT(*) AS rows_loaded, ROUND( TIMESTAMPDIFF( MICROSECOND, v_table_start, v_table_end ) 
        / 1000000, 3) AS duration_seconds
    FROM silver.erp_loc_a101;
    
	-- =========================================================================
    -- 6. LOAD ERP PRODUCT CATEGORY INFORMATION
    -- =========================================================================
	SET v_table_start = NOW(6);
    
    TRUNCATE silver.erp_px_cat_g1v2;

	INSERT INTO silver.erp_px_cat_g1v2 
	(id, cat, subcat, maintenance)
	SELECT id, cat,subcat, maintenance
	FROM bronze.erp_px_cat_g1v2;
    
    
	SET v_table_end = NOW(6);

    SELECT
        'silver.erp_px_cat_g1v2' AS table_name,
        v_table_start AS start_time,
        v_table_end AS end_time,
        COUNT(*) AS rows_loaded, ROUND( TIMESTAMPDIFF( MICROSECOND, v_table_start, v_table_end ) 
        / 1000000, 3) AS duration_seconds
    FROM silver.erp_px_cat_g1v2;
	-- =========================================================================
    -- COMPLETE SILVER LOAD
    -- =========================================================================

   SET v_silver_end = NOW(6);

    SELECT
        'Complete Silver Load' AS process_name,
		v_silver_start AS start_time,
        v_silver_end AS end_time,

        ROUND(TIMESTAMPDIFF(MICROSECOND, v_silver_start, v_silver_end) / 1000000,3) AS total_duration_seconds;

END $$

DELIMITER ;

CALL silver.load_silver()
  

